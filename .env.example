# --- Pollar -------------------------------------------------------------
# Publishable key from the Pollar dashboard. Without it the app runs in demo
# mode with a labelled sandbox wallet.
NEXT_PUBLIC_POLLAR_API_KEY=

# Set to false (with a key present) to use live Pollar wallet onboarding and
# real Stellar settlement.
NEXT_PUBLIC_DEMO_MODE=true

# --- Stellar settlement -------------------------------------------------
# Where the corridor's USDC settles on the African leg. Required for on-chain
# settlement; without it the app records a sandbox settlement instead.
NEXT_PUBLIC_CORRIDOR_TREASURY_ADDRESS=

# Defaults to Circle's USDC issuer on the Stellar test network.
NEXT_PUBLIC_USDC_ISSUER=

# testnet | public
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# --- Agent desk ---------------------------------------------------------
# Leave empty to keep the agent desk open (local development). Setting it
# requires agent sign-in before any funding confirmation, and enables the
# x-agent-key header for programmatic access.
AGENT_CONSOLE_PASSWORD=

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
